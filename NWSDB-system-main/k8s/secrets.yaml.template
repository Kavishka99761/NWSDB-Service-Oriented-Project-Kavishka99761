apiVersion: v1
kind: Secret
metadata:
  name: nwsdb-secrets
  namespace: nwsdb
  labels:
	app: nwsdb
	component: secrets
type: Opaque
stringData:
  # Database credentials - REPLACE WITH YOUR VALUES
  # Base64 encode sensitive values before deploying to production
  db-username: "admin"
  db-password: "CHANGE_ME_STRONG_PASSWORD"

  # API authentication secrets
  jwt-secret-key: "CHANGE_ME_WITH_STRONG_JWT_KEY"

  # Azure Container Registry credentials - REPLACE WITH YOUR ACR CREDENTIALS
  # Reference: this will be used in imagePullSecrets
  acr-username: "CHANGE_ME_ACR_USERNAME"
  acr-password: "CHANGE_ME_ACR_PASSWORD"
  acr-server: "nwsdbacr.azurecr.io"

  # Email/SMTP configuration if needed
  smtp-host: "CHANGE_ME_SMTP_HOST"
  smtp-port: "587"
  smtp-username: "CHANGE_ME_SMTP_USERNAME"
  smtp-password: "CHANGE_ME_SMTP_PASSWORD"

---
# Image Pull Secret for ACR
apiVersion: v1
kind: Secret
metadata:
  name: acr-secret
  namespace: nwsdb
type: docker-registry
data:
  # Create with: kubectl create secret docker-registry acr-secret \
  # --docker-server=nwsdbacr.azurecr.io \
  # --docker-username=<acr-username> \
  # --docker-password=<acr-password> \
  # --docker-email=<your-email> \
  # -n nwsdb
  # Then run: kubectl get secret acr-secret -o yaml
  .dockerconfigjson: CHANGE_ME_BASE64_ENCODED_DOCKER_CONFIG
