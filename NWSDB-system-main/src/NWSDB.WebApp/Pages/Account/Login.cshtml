@page
@model NWSDB.WebApp.Pages.Account.LoginModel
@{
    ViewData["Title"] = "Customer & Staff Login";
}

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-md-6 col-lg-5">
            <div class="card card-custom p-4 shadow">
                <div class="text-center mb-4">
                    <div class="bg-primary bg-opacity-10 text-primary p-3 rounded-circle d-inline-block mb-2">
                        <i class="bi bi-shield-lock-fill fs-2"></i>
                    </div>
                    <h3 class="fw-bold text-primary">NWSDB Portal Login</h3>
                    <p class="small text-muted">Access your bills, water usage, and account settings</p>
                </div>

                @if (!string.IsNullOrEmpty(Model.ErrorMessage))
                {
                    <div class="alert alert-danger py-2 small" role="alert">
                        <i class="bi bi-exclamation-triangle-fill me-1"></i> @Model.ErrorMessage
                    </div>
                }

                <form method="post">
                    <div class="mb-3">
                        <label class="form-label fw-bold small">Username</label>
                        <div class="input-group">
                            <span class="input-group-text"><i class="bi bi-person"></i></span>
                            <input type="text" asp-for="Username" class="form-control" placeholder="Enter your username" required />
                        </div>
                    </div>

                    <div class="mb-4">
                        <label class="form-label fw-bold small">Password</label>
                        <div class="input-group">
                            <span class="input-group-text"><i class="bi bi-key"></i></span>
                            <input type="password" asp-for="Password" class="form-control" placeholder="Enter your password" required />
                        </div>
                    </div>

                    <div class="d-grid mb-3">
                        <button type="submit" class="btn btn-primary btn-lg fw-bold" style="background-color: #0077b6;">
                            <i class="bi bi-box-arrow-in-right me-1"></i> Login to Portal
                        </button>
                    </div>

                    <div class="text-center small text-muted mb-4">
                        Don't have an online profile? <a asp-page="/Account/Register" class="text-primary fw-bold">Register Connection</a>
                    </div>
                </form>

                <!-- Quick Test Credentials Box -->
                <div class="p-3 bg-light rounded-3 border">
                    <div class="small fw-bold text-secondary mb-2"><i class="bi bi-info-circle me-1"></i>Quick Test Demo Accounts:</div>
                    <div class="d-flex justify-content-between">
                        <a asp-page="/Account/Login" asp-route-demoUser="customer" class="btn btn-sm btn-outline-primary">
                            Demo Customer (sunil / sunil123)
                        </a>
                        <a asp-page="/Account/Login" asp-route-demoUser="admin" class="btn btn-sm btn-outline-secondary">
                            Demo Admin (admin / admin123)
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
