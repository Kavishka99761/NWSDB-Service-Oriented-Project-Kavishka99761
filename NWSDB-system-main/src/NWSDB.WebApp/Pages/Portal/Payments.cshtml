@page
@model NWSDB.WebApp.Pages.Portal.PaymentsModel
@{
    ViewData["Title"] = "Payment History";
}

<div class="container py-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h3 class="fw-bold text-primary mb-1"><i class="bi bi-clock-history me-2"></i>Payment History & Receipts</h3>
            <p class="text-muted mb-0">Verified transactions for Account <strong>@(Model.Customer?.AccountNumber ?? "ACC10001")</strong> (@Model.Customer?.FullName)</p>
        </div>
        <div>
            <a asp-page="/Payment" asp-route-accountNumber="@(Model.Customer?.AccountNumber ?? "ACC10001")" class="btn btn-warning fw-bold">
                <i class="bi bi-credit-card me-1"></i> Make New Payment
            </a>
        </div>
    </div>

    <!-- Payments Ledger -->
    <div class="card card-custom p-4">
        <div class="table-responsive">
            <table class="table table-hover align-middle">
                <thead class="table-light">
                    <tr>
                        <th>Receipt Reference</th>
                        <th>Bill Link</th>
                        <th>Payment Date</th>
                        <th>Method</th>
                        <th>Account / Card Masked</th>
                        <th>Amount Paid (Rs.)</th>
                        <th>Status</th>
                        <th>Channel</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model.Payments.Any())
                    {
                        @foreach (var p in Model.Payments)
                        {
                            <tr>
                                <td class="fw-bold text-primary">@p.PaymentReference</td>
                                <td>@(p.BillId.HasValue ? $"Bill #{p.BillId}" : "Advance Payment")</td>
                                <td>@p.PaymentDate.ToString("yyyy-MM-dd HH:mm:ss")</td>
                                <td>@p.Method</td>
                                <td class="font-monospace text-muted">@p.MaskedAccount</td>
                                <td class="fw-bold fs-6 text-success">Rs. @p.Amount.ToString("N2")</td>
                                <td>
                                    <span class="badge bg-success px-3 py-1">@p.Status.ToUpper()</span>
                                </td>
                                <td>@(p.PartnerName ?? "Web Portal Direct")</td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="8" class="text-center text-muted py-3">No payments recorded for this account.</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
