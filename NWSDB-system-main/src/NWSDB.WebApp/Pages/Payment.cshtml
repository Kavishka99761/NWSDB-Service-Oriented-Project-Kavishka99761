@page
@model PaymentModel
@{
    ViewData["Title"] = "Online Bill Payment";
}

<div class="container py-3">
    <!-- Header -->
    <div class="text-center mb-4">
        <h2 class="fw-bold text-primary"><i class="bi bi-credit-card-2-front me-2"></i>NWSDB Online Bill Payment Gateway</h2>
        <p class="text-muted">Direct, instant, and secure settlement of domestic and commercial water bills in Sri Lanka.</p>
    </div>

    <!-- Error Alert -->
    @if (!string.IsNullOrEmpty(Model.ErrorMessage))
    {
        <div class="alert alert-danger alert-dismissible fade show shadow-sm" role="alert">
            <i class="bi bi-exclamation-triangle-fill me-2"></i> @Model.ErrorMessage
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    <!-- Payment Receipt Confirmation Modal / Card -->
    @if (Model.Receipt != null)
    {
        <div class="card card-custom border-2 border-success shadow-lg mb-5">
            <div class="card-header bg-success text-white py-3 d-flex justify-content-between align-items-center">
                <span class="fs-5 fw-bold"><i class="bi bi-check-circle-fill me-2"></i>Payment Successful - Official Receipt</span>
                <span class="badge bg-light text-success fs-6">CONFIRMED</span>
            </div>
            <div class="card-body p-4" id="printableReceipt">
                <div class="row align-items-center border-bottom pb-3 mb-3">
                    <div class="col-sm-6">
                        <h4 class="fw-bold text-primary mb-0">NWSDB Sri Lanka</h4>
                        <small class="text-muted">National Water Supply and Drainage Board</small>
                    </div>
                    <div class="col-sm-6 text-sm-end mt-2 mt-sm-0">
                        <div class="fw-bold text-secondary">Receipt Reference:</div>
                        <span class="badge bg-primary fs-6">@Model.Receipt.PaymentReference</span>
                    </div>
                </div>

                <div class="row g-3 mb-4">
                    <div class="col-md-6">
                        <div class="p-3 bg-light rounded-3">
                            <span class="text-muted small d-block">Account Number:</span>
                            <span class="fw-bold fs-5">@Model.Receipt.AccountNumber</span>
                            
                            <span class="text-muted small d-block mt-2">Customer Name:</span>
                            <span class="fw-bold">@Model.Receipt.CustomerName</span>

                            <span class="text-muted small d-block mt-2">Channel / Method:</span>
                            <span class="fw-bold">@Model.Receipt.PaymentMethod (@Model.Receipt.MaskedCardOrPhone)</span>
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="p-3 bg-light rounded-3 text-md-end">
                            <span class="text-muted small d-block">Date & Time of Transaction:</span>
                            <span class="fw-bold">@Model.Receipt.PaymentDate.ToString("yyyy-MM-dd HH:mm:ss UTC")</span>

                            <span class="text-muted small d-block mt-2">Amount Paid:</span>
                            <span class="fs-3 fw-bold text-success">Rs. @Model.Receipt.AmountPaid.ToString("N2")</span>

                            <span class="text-muted small d-block mt-2">Remaining Outstanding Balance:</span>
                            <span class="fw-bold text-danger">Rs. @Model.Receipt.RemainingBalance.ToString("N2")</span>
                        </div>
                    </div>
                </div>

                <div class="alert alert-info py-2 small mb-4">
                    <i class="bi bi-info-circle-fill me-1"></i> @Model.Receipt.Message
                </div>

                <div class="d-flex justify-content-end gap-2">
                    <button type="button" class="btn btn-outline-secondary" onclick="window.print()">
                        <i class="bi bi-printer me-1"></i> Print Official Receipt
                    </button>
                    <a asp-page="/Portal/Payments" class="btn btn-primary" style="background-color: #0077b6;">
                        <i class="bi bi-clock-history me-1"></i> View In Payment History
                    </a>
                </div>
            </div>
        </div>
    }

    <!-- Step 1: Account Lookup -->
    <div class="card card-custom p-4 mb-4">
        <h5 class="fw-bold text-primary mb-3"><i class="bi bi-1-circle-fill me-2"></i>Step 1: Locate Customer Water Connection</h5>
        <form method="post" asp-page-handler="Lookup" class="row g-3 align-items-center">
            <div class="col-md-8">
                <div class="input-group input-group-lg">
                    <span class="input-group-text bg-light"><i class="bi bi-hash"></i></span>
                    <input type="text" asp-for="AccountNumber" class="form-control" placeholder="Enter Account Number (e.g. ACC10001)" required />
                </div>
            </div>
            <div class="col-md-4">
                <button type="submit" class="btn btn-primary btn-lg w-100 fw-bold" style="background-color: #0077b6;">
                    <i class="bi bi-search me-1"></i> Fetch Account Details
                </button>
            </div>
        </form>

        <div class="mt-3">
            <small class="text-muted fw-bold me-2">Sample Demo Accounts:</small>
            <a asp-page="/Payment" asp-route-accountNumber="ACC10001" class="badge bg-light text-primary text-decoration-none border me-1 py-2 px-2">ACC10001 (Sunil)</a>
            <a asp-page="/Payment" asp-route-accountNumber="ACC10002" class="badge bg-light text-primary text-decoration-none border me-1 py-2 px-2">ACC10002 (Kamala)</a>
            <a asp-page="/Payment" asp-route-accountNumber="ACC10003" class="badge bg-light text-primary text-decoration-none border me-1 py-2 px-2">ACC10003 (Nimal)</a>
            <a asp-page="/Payment" asp-route-accountNumber="ACC10004" class="badge bg-light text-primary text-decoration-none border py-2 px-2">ACC10004 (Fathima)</a>
        </div>
    </div>

    <!-- Step 2: Customer Details & Outstanding Bills -->
    @if (Model.Customer != null)
    {
        <div class="row g-4 mb-4">
            <!-- Customer Information Card -->
            <div class="col-lg-5">
                <div class="card card-custom h-100">
                    <div class="card-header card-header-nwsdb py-3">
                        <i class="bi bi-person-badge-fill me-2"></i>Connection Information
                    </div>
                    <div class="card-body p-4">
                        <div class="mb-3 border-bottom pb-2">
                            <span class="text-muted small d-block">Account Holder:</span>
                            <span class="fw-bold fs-5 text-dark">@Model.Customer.FullName</span>
                        </div>
                        <div class="mb-3 border-bottom pb-2">
                            <span class="text-muted small d-block">Account Number:</span>
                            <span class="badge bg-primary fs-6">@Model.Customer.AccountNumber</span>
                        </div>
                        <div class="mb-3 border-bottom pb-2">
                            <span class="text-muted small d-block">Premises Address:</span>
                            <span class="fw-bold">@Model.Customer.Address</span>
                        </div>
                        <div class="mb-3 border-bottom pb-2">
                            <span class="text-muted small d-block">Area / Branch Office:</span>
                            <span>@Model.Customer.AreaBranch</span>
                        </div>
                        <div class="mb-3 border-bottom pb-2">
                            <span class="text-muted small d-block">Meter Number:</span>
                            <span class="badge bg-secondary font-monospace">@Model.Customer.MeterNumber</span>
                        </div>
                        <div>
                            <span class="text-muted small d-block">Total Outstanding Balance:</span>
                            <span class="fs-4 fw-bold @(Model.TotalOutstanding > 0 ? "text-danger" : "text-success")">
                                Rs. @Model.TotalOutstanding.ToString("N2")
                            </span>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Step 3: Payment Checkout Form -->
            <div class="col-lg-7">
                <div class="card card-custom h-100">
                    <div class="card-header card-header-nwsdb py-3" style="background: linear-gradient(135deg, #00509e, #0077b6);">
                        <i class="bi bi-credit-card me-2"></i>Step 2: Enter Payment Details
                    </div>
                    <div class="card-body p-4">
                        <form method="post" asp-page-handler="Pay">
                            <input type="hidden" asp-for="AccountNumber" />

                            <!-- Unpaid Bills Selection -->
                            @if (Model.UnpaidBills.Any())
                            {
                                <div class="mb-3">
                                    <label class="form-label fw-bold">Select Bill to Settle:</label>
                                    <select asp-for="SelectedBillId" class="form-select form-select-lg">
                                        @foreach (var bill in Model.UnpaidBills)
                                        {
                                            <option value="@bill.Id">
                                                Period: @bill.MonthYear | Due: @bill.DueDate.ToString("yyyy-MM-dd") | Amount: Rs. @bill.TotalAmount.ToString("N2")
                                            </option>
                                        }
                                    </select>
                                </div>
                            }

                            <!-- Payment Amount -->
                            <div class="mb-3">
                                <label class="form-label fw-bold">Payment Amount (LKR):</label>
                                <div class="input-group input-group-lg">
                                    <span class="input-group-text fw-bold text-success">Rs.</span>
                                    <input type="number" asp-for="PaymentAmount" step="0.01" min="1" class="form-control fw-bold" required />
                                </div>
                            </div>

                            <!-- Payment Method Selection -->
                            <div class="mb-3">
                                <label class="form-label fw-bold">Payment Method:</label>
                                <div class="row g-2">
                                    <div class="col-4">
                                        <input type="radio" class="btn-check" name="Method" id="methodCard" value="CreditCard" checked />
                                        <label class="btn btn-outline-primary w-100 py-2 small fw-bold" for="methodCard">
                                            <i class="bi bi-credit-card d-block fs-4"></i> Credit / Debit
                                        </label>
                                    </div>
                                    <div class="col-4">
                                        <input type="radio" class="btn-check" name="Method" id="methodBank" value="OnlineBanking" />
                                        <label class="btn btn-outline-primary w-100 py-2 small fw-bold" for="methodBank">
                                            <i class="bi bi-bank d-block fs-4"></i> Online Bank
                                        </label>
                                    </div>
                                    <div class="col-4">
                                        <input type="radio" class="btn-check" name="Method" id="methodWallet" value="PartnerApp" />
                                        <label class="btn btn-outline-primary w-100 py-2 small fw-bold" for="methodWallet">
                                            <i class="bi bi-phone d-block fs-4"></i> eZ Cash / Partner
                                        </label>
                                    </div>
                                </div>
                            </div>

                            <!-- Card or Account Number -->
                            <div class="mb-3">
                                <label class="form-label fw-bold">Card Number / Bank Account / Phone:</label>
                                <div class="input-group">
                                    <span class="input-group-text"><i class="bi bi-credit-card"></i></span>
                                    <input type="text" asp-for="CardOrAccountNumber" class="form-control" placeholder="4111 2222 3333 4444" required />
                                </div>
                                <small class="text-muted">For testing: Enter any 16-digit card number or wallet phone number.</small>
                            </div>

                            <!-- Expiry and CVV -->
                            <div class="row g-3 mb-3">
                                <div class="col-6">
                                    <label class="form-label fw-bold">Expiry Date:</label>
                                    <input type="text" asp-for="CardExpiry" class="form-control" placeholder="MM/YY" value="12/28" />
                                </div>
                                <div class="col-6">
                                    <label class="form-label fw-bold">CVV / CVC:</label>
                                    <input type="password" asp-for="CardCvv" maxlength="4" class="form-control" placeholder="123" value="789" />
                                </div>
                            </div>

                            <!-- Optional Notes -->
                            <div class="mb-4">
                                <label class="form-label small text-muted">Notes / Reference (Optional):</label>
                                <input type="text" asp-for="Notes" class="form-control form-control-sm" placeholder="e.g. September Bill Payment" />
                            </div>

                            <!-- Submit Payment Button -->
                            <div class="d-grid">
                                <button type="submit" class="btn btn-success btn-lg fw-bold shadow py-3">
                                    <i class="bi bi-shield-lock-fill me-2"></i> Authorize & Confirm Payment
                                </button>
                            </div>
                        </form>
                    </div>
                </div>
            </div>
        </div>
    }
</div>
